# macOS
.DS_Store
.claude/skills/.DS_Store

# Python
venv/
__pycache__/
*.pyc
*.pyo
.env

# Obsidian app config (local-only)
.obsidian/

# Claude workspace metadata (.claude/ contents ignored except project settings)
.claude/*
!.claude/settings.json
!.claude/README.md
!.claude/skills
!.claude/skills/**

# Files generated by Obsidian plugins (local-only)
.obsidian/plugins/obsidian-git/

# Archive files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
archive/
Downloads/

# Binary / large assets
images/*
!images/paper-texture-top-view-2.jpg
!images/people/ancestries/
!images/classes/
docs/images/
docs/assets/
audio/
narrative/audio/
!narrative/audio/The Road_A Fable.mp3
references/
bd
bd_linux

# Natural Earth raw downloads (public domain, trivially re-fetchable from
# naturalearthdata.com) -- only the clipped, project-specific subset is kept
utilities/world/natural_earth/*.zip
utilities/world/natural_earth/ne_10m_coastline/
utilities/world/natural_earth/ne_10m_lakes/
utilities/world/natural_earth/ne_10m_populated_places/
utilities/world/natural_earth/ne_10m_rivers_lake_centerlines/

# Binary file types (tracked text data like .geojson/.kml is fine)
*.pdf
*.zip
*.webarchive
*.webm
*.mp4
*.mov

# OSM / Overpass API response caches (local-only, not committed)
world/data/.routes_cache.json
world/data/.waystations_cache.json

# Workflow and build artifacts
docs/*.html
docs/**/*.html
!docs/login.html
!docs/icon-preview.html
!docs/session2-map.html
docs/search-index.json

# External tool integration (not source content)
moulinette/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# LK bridge round-trip artifacts (generated exports, LK re-exports, reimports)
utilities/lk-bridge/roundtrip/
utilities/lk-bridge/lk_manifest.json
