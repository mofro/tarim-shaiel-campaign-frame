# macOS
.DS_Store

# Python
venv/
__pycache__/
*.pyc
*.pyo
.env

# Obsidian app config (local-only)
.obsidian/

# Claude workspace metadata (.claude/ contents ignored except project settings)
.claude/*
!.claude/settings.json

# Files generated by Obsidian plugins (local-only)
.obsidian/plugins/obsidian-git/

# Archive files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
archive/

# Binary / large assets
images/*
!images/paper-texture-top-view-2.jpg
!images/people/ancestries/
docs/images/
docs/assets/
audio/
narrative/audio/
!narrative/audio/The Road_A Fable.mp3
references/

# Binary file types (tracked text data like .geojson/.kml is fine)
*.pdf
*.zip
*.webarchive

# Workflow and build artifacts
docs/*.html
docs/**/*.html
!docs/login.html
docs/search-index.json

# External tool integration (not source content)
moulinette/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
